# Copy this file to .env.local and fill in your Supabase project's values
# (Settings > API in the Supabase dashboard, or `supabase status` locally).
# Both must be prefixed EXPO_PUBLIC_ to be readable from client code.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# LinkedIn Developer App's Client ID (Settings' "Share on LinkedIn" feature).
# Safe to expose client-side — only the Client Secret (an Edge Function
# secret, never here) is sensitive. Get it from
# https://www.linkedin.com/developers/apps after creating an app and
# requesting the "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn" products.
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=
